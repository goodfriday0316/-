{
  "name": "bazaar-deck-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "playwright test",
    "preview": "vite preview",
    "data:update": "node scripts/update-items.mjs",
    "test:data": "node tests/data-pipeline.test.mjs",
    "test:production": "playwright test --config playwright.production.config.ts --workers=1",
    "test:raw-contract": "node tests/raw-data-contract.test.mjs",
    "test:adapter": "node --experimental-strip-types tests/raw-adapter.test.ts",
    "test:local-storage": "node --experimental-strip-types tests/local-library.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
